# EXAMPLES ONLY. Do not commit a real .env file or secrets to Git.
# For the quick localhost-only demo, no env vars are required.
# For Compose/Keycloak, run: python3 scripts/setup_local_credentials.py
# That creates gitignored .env with unique values for:
# DEMO_ADMIN_PASSWORD, DEMO_VIEWER_PASSWORD, KEYCLOAK_ADMIN_PASSWORD,
# and GRAFANA_ADMIN_PASSWORD. Never put real passwords in this example.
APP_ENV=development
AUTH_MODE=demo
SEED_DEMO=true
AUTO_CREATE_SCHEMA=true
DATABASE_URL=sqlite:///./launchpilot.db

# Production-style compose sets the OIDC/Postgres/Redis/Kafka configuration.
# For standalone production, AUTH_MODE=oidc and APP_ENV=production are REQUIRED.
# OIDC_ISSUER=https://identity.example.com/realms/launchpilot
# OIDC_AUDIENCE=launchpilot-api
# OIDC_JWKS_URL=https://identity.example.com/realms/launchpilot/protocol/openid-connect/certs
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL_SECONDS=15
# EVENT_TRANSPORT=kafka
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_TOPIC=launchpilot.events.v1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# METRICS_TOKEN=replace-with-random-secret

# Build-time frontend variables (they are PUBLIC, never include secrets):
# VITE_AUTH_MODE=oidc
# VITE_OIDC_AUTHORITY=https://identity.example.com/realms/launchpilot
# VITE_OIDC_CLIENT_ID=launchpilot-web
