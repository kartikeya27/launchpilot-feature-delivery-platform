{
  "realm": "launchpilot",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "launchpilot_admin"
      },
      {
        "name": "launchpilot_viewer"
      }
    ]
  },
  "clients": [
    {
      "clientId": "launchpilot-web",
      "name": "LaunchPilot local SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "http://127.0.0.1:8000",
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "launchpilot-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "",
            "included.custom.audience": "launchpilot-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo-admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "AdminDemo123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "launchpilot_admin",
        "launchpilot_viewer"
      ],
      "firstName": "Demo",
      "lastName": "Administrator",
      "email": "admin@launchpilot.example"
    },
    {
      "username": "demo-viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "ViewerDemo123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "launchpilot_viewer"
      ],
      "firstName": "Demo",
      "lastName": "Viewer",
      "email": "viewer@launchpilot.example"
    }
  ]
}
